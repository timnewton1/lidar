#!/usr/bin/env bash
# `lidar run` — download USGS lidar tiles and produce KML/KMZ/COG outputs.
#
# Usage: lidar run [options] <list.txt|URL> [<list.txt|URL>...]
#
# Each positional is a local .txt tile list or a bare tile https:// URL.
# When the list spans multiple USGS projects, one independent run is
# dispatched per project. Runs execute concurrently (bounded by --jobs)
# and are detached; the command returns immediately after dispatch.
#
# Options:
#   -s, --shading LIST       comma-separated shadings (default: hillshade)
#                            Known: hillshade, slopeshade
#   -a, --algorithm ALG      hillshade algorithm: Horn (default) | ZevenbergenThorne
#                            Horn is the safer default for noisy lidar DEMs.
#   -m, --multidirectional   use gdaldem -multidirectional (USGS's choice);
#                            otherwise -combined with az=315 alt=45.
#   -j, --jobs N             max concurrent project runs (default: auto)
#   -g, --gis-dir PATH       override GIS_DIR for this run
#   -o, --output OUTPUTS     comma-separated outputs (default: kml).
#                            Known: kml, kmz, cog.
#                              kml — Google Earth super-overlay tile pyramid
#                              kmz — kml + zipped .kmz (auto-enables kml)
#                              cog — Cloud-Optimized GeoTIFFs (no KML pyramid)
#                            'cog' without 'kml' is dramatically faster —
#                            skips the WGS84 reproject and tile pyramid steps.
#       --cog-crs EPSG:NNNN  reproject COG output to this CRS (default: source
#                            CRS if projected, else auto-pick UTM zone)
#       --cog-no-reproject   keep source CRS even if geographic (warns; QGIS
#                            3D Map View may not render geographic CRSes)
#   -d, --dry-run            validate inputs and print resolved plan; exit 0
#   --strict-downloads       abort the run if any tile fails to download
#                            (default: proceed with successfully-downloaded tiles)
#   -h, --help               show this help

source "${LIDAR_HOME}/lib/strict.sh"

usage() {
  sed -n '3,37p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit "${1:-1}"
}

SHADINGS_CSV="hillshade"
OUTPUTS_CSV=""
COG_CRS=""
COG_NO_REPROJECT=0
GIS_DIR_OVERRIDE=""
INPUTS=()
ALGORITHM=""
MULTIDIRECTIONAL=0
JOBS_OVERRIDE=""
DRY_RUN=0
STRICT_DOWNLOADS=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -s|--shading)          SHADINGS_CSV="$2"; shift 2 ;;
    -a|--algorithm)        ALGORITHM="$2"; shift 2 ;;
    -m|--multidirectional) MULTIDIRECTIONAL=1; shift ;;
    -j|--jobs)             JOBS_OVERRIDE="$2"; shift 2 ;;
    -g|--gis-dir)          GIS_DIR_OVERRIDE="$2"; shift 2 ;;
    -o|--output)           OUTPUTS_CSV="$2"; shift 2 ;;
    --cog-crs)             COG_CRS="$2"; shift 2 ;;
    --cog-no-reproject)    COG_NO_REPROJECT=1; shift ;;
    --strict-downloads)    STRICT_DOWNLOADS=1; shift ;;
    -d|--dry-run)          DRY_RUN=1; shift ;;
    -h|--help)             usage 0 ;;
    -*)                    echo "Unknown flag: $1" >&2; usage ;;
    *)                     INPUTS+=("$1"); shift ;;
  esac
done

# ─── Resolve --output → OUTPUT_KML / OUTPUT_KMZ / OUTPUT_COG ─────────────────
OUTPUT_KML=0
OUTPUT_KMZ=0
OUTPUT_COG=0
[[ -z "${OUTPUTS_CSV}" ]] && OUTPUTS_CSV="kml"
IFS=',' read -r -a _OUT_TOKENS <<< "${OUTPUTS_CSV}"
for tok in "${_OUT_TOKENS[@]}"; do
  case "${tok,,}" in
    kml) OUTPUT_KML=1 ;;
    kmz) OUTPUT_KMZ=1 ;;
    cog) OUTPUT_COG=1 ;;
    "")  echo "ERROR: --output got empty token" >&2; exit 1 ;;
    *)   echo "ERROR: --output unknown: '${tok}' (known: kml, kmz, cog)" >&2; exit 1 ;;
  esac
done
# kmz needs the pyramid to exist, but when the user didn't ask for kml the
# tree is intermediate — it gets built under _proj_work and reclaimed on exit
# (see KML_STAGE_ROOT below). When the user asked for kml, the tree IS the
# deliverable and lives under OUT_DIR.
NEED_PYRAMID=0
[[ ${OUTPUT_KML} -eq 1 || ${OUTPUT_KMZ} -eq 1 ]] && NEED_PYRAMID=1
if [[ ${OUTPUT_KML} -eq 0 && ${OUTPUT_KMZ} -eq 0 && ${OUTPUT_COG} -eq 0 ]]; then
  echo "ERROR: --output produced no outputs" >&2
  exit 1
fi

# ─── Validate COG-modifier flags ─────────────────────────────────────────────
if [[ -n "${COG_CRS}" ]]; then
  [[ "${COG_CRS}" =~ ^EPSG:[0-9]+$ ]] || {
    echo "ERROR: --cog-crs must match 'EPSG:NNNN' (got: ${COG_CRS})" >&2
    exit 1
  }
fi
if [[ -n "${COG_CRS}" || ${COG_NO_REPROJECT} -eq 1 ]] && [[ ${OUTPUT_COG} -eq 0 ]]; then
  echo "ERROR: --cog-crs / --cog-no-reproject require --output to include cog" >&2
  exit 1
fi
if [[ -n "${COG_CRS}" && ${COG_NO_REPROJECT} -eq 1 ]]; then
  echo "ERROR: --cog-crs and --cog-no-reproject are mutually exclusive" >&2
  exit 1
fi

# ─── Validate --jobs ─────────────────────────────────────────────────────────
if [[ -n "${JOBS_OVERRIDE}" ]]; then
  [[ "${JOBS_OVERRIDE}" =~ ^[1-9][0-9]*$ ]] || {
    echo "ERROR: --jobs must be a positive integer (got: ${JOBS_OVERRIDE})" >&2; exit 1
  }
fi

[[ -n "${GIS_DIR_OVERRIDE}" ]] && export GIS_DIR="${GIS_DIR_OVERRIDE}"
export STRICT_DOWNLOADS

source "${LIDAR_HOME}/lib/common.sh"
source "${LIDAR_HOME}/lib/events.sh"
source "${LIDAR_HOME}/lib/download.sh"
source "${LIDAR_HOME}/lib/gdal.sh"
source "${LIDAR_HOME}/lib/kml.sh"
source "${LIDAR_HOME}/lib/cog.sh"
source "${LIDAR_HOME}/lib/diag.sh"

[[ ${#INPUTS[@]} -eq 0 ]] && usage

# ─── Combine all inputs into one URL stream ──────────────────────────────────
COMBINED_LIST=$(mktemp "${LIDAR_DIR}/.combined_XXXXXX.txt")
trap 'rm -f "${COMBINED_LIST}"' EXIT

for _inp in "${INPUTS[@]}"; do
  if [[ "${_inp}" =~ ^https?://.*\.tif([?#]|$) ]]; then
    echo "${_inp}" >> "${COMBINED_LIST}"
  elif [[ "${_inp}" =~ ^https?:// ]]; then
    _fetched=$(mktemp "${LIDAR_DIR}/.fetch_XXXXXX.txt")
    curl -L --retry 5 --retry-all-errors --fail-with-body --max-time 120 \
      -o "${_fetched}.partial" "${_inp}" \
      || { echo "ERROR: failed to fetch ${_inp}" >&2; rm -f "${_fetched}.partial" "${_fetched}"; exit 1; }
    mv -f "${_fetched}.partial" "${_fetched}"
    grep -i '\.tif' "${_fetched}" | grep -v '^#' | grep -v '^[[:space:]]*$' >> "${COMBINED_LIST}" || true
    rm -f "${_fetched}"
  else
    [[ -f "${_inp}" ]] || { echo "ERROR: File not found: ${_inp}" >&2; exit 1; }
    grep -i '\.tif' "${_inp}" | grep -v '^#' | grep -v '^[[:space:]]*$' >> "${COMBINED_LIST}" || true
  fi
done

if [[ ! -s "${COMBINED_LIST}" ]]; then
  echo "ERROR: No .tif URLs found in inputs: ${INPUTS[*]}" >&2
  exit 1
fi

# ─── Parse + validate shadings ───────────────────────────────────────────────
IFS=',' read -r -a SHADINGS <<< "${SHADINGS_CSV}"
for s in "${SHADINGS[@]}"; do
  is_known_shading "${s}" || {
    echo "ERROR: unknown shading: ${s}" >&2
    echo "  Known: ${KNOWN_SHADINGS[*]}" >&2
    exit 1
  }
done

# ─── Apply hillshade tuning flags ────────────────────────────────────────────
if [[ -n "${ALGORITHM}" ]]; then
  case "${ALGORITHM}" in
    Horn|ZevenbergenThorne) HS_ALGORITHM="${ALGORITHM}" ;;
    *) echo "ERROR: --algorithm must be Horn or ZevenbergenThorne" >&2; exit 1 ;;
  esac
fi
[[ ${MULTIDIRECTIONAL} -eq 1 ]] && HS_MULTIDIRECTIONAL=1

extra_deps=()
[[ ${OUTPUT_KMZ} -eq 1 ]] && extra_deps+=(zip)
[[ ${OUTPUT_COG} -eq 1 ]] && extra_deps+=(python3)

# ─── Fan-out by project ───────────────────────────────────────────────────────
WORK_DIR=$(mktemp -d "${LIDAR_DIR}/.work_XXXXXX")

_FALLBACK_PROJECT=""
if [[ "${INPUTS[0]}" != *'://'* ]]; then
  _FALLBACK_PROJECT="_$(basename "${INPUTS[0]}" .txt)"
fi

_FANOUT_TSV="${WORK_DIR}/fanout.tsv"
fanout_by_project "${_FALLBACK_PROJECT}" < "${COMBINED_LIST}" > "${_FANOUT_TSV}"

if [[ ! -s "${_FANOUT_TSV}" ]]; then
  echo "ERROR: no URL groups found — are URLs in USGS Projects/<name>/ format?" >&2
  exit 1
fi

mapfile -t _FANOUT_PROJECTS < <(cut -f1 "${_FANOUT_TSV}")
mapfile -t _FANOUT_URLFILES < <(cut -f2 "${_FANOUT_TSV}")
_N_PROJECTS="${#_FANOUT_PROJECTS[@]}"

# ─── --dry-run: print fan-out plan and exit ───────────────────────────────────
if [[ ${DRY_RUN} -eq 1 ]]; then
  OUTPUTS_PLAN=""
  [[ ${OUTPUT_KML} -eq 1 ]] && OUTPUTS_PLAN+="kml "
  [[ ${OUTPUT_KMZ} -eq 1 ]] && OUTPUTS_PLAN+="kmz "
  [[ ${OUTPUT_COG} -eq 1 ]] && OUTPUTS_PLAN+="cog "

  echo "=== DRY RUN PLAN ==="
  echo "Inputs      : ${INPUTS[*]}"
  echo "Projects    : ${_N_PROJECTS}"
  echo "Jobs        : ${JOBS_OVERRIDE:-auto}"
  echo "Shadings    : ${SHADINGS[*]}"
  echo "Algorithm   : ${HS_ALGORITHM} (multidirectional=${HS_MULTIDIRECTIONAL})"
  echo "Outputs     : ${OUTPUTS_PLAN% }"
  echo "strict_downloads=${STRICT_DOWNLOADS}"
  if [[ ${OUTPUT_COG} -eq 1 ]]; then
    if [[ -n "${COG_CRS}" ]]; then
      echo "COG CRS     : ${COG_CRS} (explicit)"
    elif [[ ${COG_NO_REPROJECT} -eq 1 ]]; then
      echo "COG CRS     : native (no-reproject)"
    else
      echo "COG CRS     : auto (source CRS if projected; else UTM)"
    fi
  fi
  echo ""
  for (( _i=0; _i<_N_PROJECTS; _i++ )); do
    _proj="${_FANOUT_PROJECTS[_i]}"
    _cnt=$(wc -l < "${_FANOUT_URLFILES[_i]}" 2>/dev/null || echo 0)
    printf "  [%d/%d] %-50s  %d URL(s)\n" "$((_i+1))" "${_N_PROJECTS}" "${_proj}" "${_cnt}"
  done
  rm -rf "${WORK_DIR}"
  exit 0
fi

# ─── Compute job parallelism ─────────────────────────────────────────────────
if [[ -n "${JOBS_OVERRIDE}" ]]; then
  JOBS="${JOBS_OVERRIDE}"
else
  _ncpu=$(nproc)
  _ram_gb=$(awk '/MemAvailable/{print int($2/1048576)}' /proc/meminfo)
  JOBS=$(( _ncpu / 2 ))
  (( _ram_gb / 2 < JOBS )) && JOBS=$(( _ram_gb / 2 ))
  (( _N_PROJECTS < JOBS )) && JOBS="${_N_PROJECTS}"
  (( JOBS < 1 )) && JOBS=1
fi

# ─── Per-project pipeline ─────────────────────────────────────────────────────
# Receives project name, hex run ID, and URL file path.
# Runs the full pipeline in its own WORK_DIR, logging to its own log file.
# All flag variables (OUTPUT_KML, SHADINGS, etc.) inherited from parent scope.
_run_one_project() {
  local _project="$1" _hex="$2" _url_file_src="$3"

  local _log_dir="${LIDAR_DIR}/logs"
  local _log="${_log_dir}/${_hex}.log"
  mkdir -p "${_log_dir}"
  exec > "${_log}" 2>&1
  events_emit_start "${_hex}" "${_log}" "${_project}" "${INPUTS[@]}"
  diag_pre_run "${PROJECTS_DIR}/${_project}"

  local _proj_work; _proj_work=$(mktemp -d "${LIDAR_DIR}/.work_XXXXXX")
  WORK_DIR="${_proj_work}"

  # Pin all scratch — ours and GDAL's — to the output disk. /tmp is tmpfs
  # (16 GB RAM) on Bazzite/Fedora; reprojected county-scale rasters routinely
  # exceed that and silently corrupt with libtiff "No space left on device"
  # while gdalwarp keeps running for hours. See a3f4a8.
  export TMPDIR="${_proj_work}" CPL_TMPDIR="${_proj_work}"

  # Copy url_file into private WORK_DIR before the parent's temp dir is removed.
  local _url_file="${_proj_work}/input.urls"
  cp "${_url_file_src}" "${_url_file}"

  local _on_exit_done=0
  _on_project_exit() {
    local _rc=$?
    [[ ${_on_exit_done} -eq 1 ]] && return; _on_exit_done=1
    echo "=========================================="
    if [[ ${_rc} -eq 0 ]]; then
      : # normal exit; ALL DONE banner already printed above
    elif [[ ${_rc} -gt 128 ]]; then
      local _sig=$(( _rc - 128 ))
      local _signame; _signame=$(kill -l "${_sig}" 2>/dev/null || echo "${_sig}")
      echo "EXIT: killed by signal ${_signame} (exit ${_rc}) — likely OOM-kill or systemd timeout"
    else
      echo "EXIT: failed with exit code ${_rc}"
    fi
    echo "=========================================="
    events_emit_end "${_hex}" "${_rc}"
    rm -rf "${_proj_work}"
  }
  _on_project_signal() { exit "$(( 128 + $(kill -l "$1") ))"; }
  trap '_on_project_signal TERM' TERM
  trap '_on_project_signal INT'  INT
  trap '_on_project_signal HUP'  HUP
  trap _on_project_exit EXIT

  # Gate on available RAM. GDAL's own default cache is 5% of usable RAM per
  # job, so wait for that much headroom — naturally queues concurrent jobs.
  local _mem_total_kb; _mem_total_kb=$(awk '/MemTotal/{print $2}' /proc/meminfo)
  local _need_kb=$(( _mem_total_kb * GDAL_CACHE_PCT / 100 ))
  while (( $(awk '/MemAvailable/{print $2}' /proc/meminfo) < _need_kb )); do
    echo "Waiting for $(( _need_kb / 1024 )) MB headroom..."
    sleep 10
  done

  cleanup_old_logs 30

  LISTS_DIR="${_proj_work}/project_lists"
  mkdir -p "${LISTS_DIR}"

  # Tell prescan which project bucket to use for non-Projects/ URLs.
  export FANOUT_PROJECT="${_project}"

  check_deps_and_input "${_url_file}" "${extra_deps[@]+"${extra_deps[@]}"}"
  prescan
  make_dirs "${PROJECTS_DIR}/${_project}/${_hex}"
  download_tiles

  # ── Step 5: resolve downloaded tiles ────────────────────────────────────────
  echo "=========================================="
  echo "STEP 5: Resolving downloaded tiles by project"
  echo "=========================================="

  local MISSING=0
  declare -A PROJECT_READY=()
  local READY_PROJECTS=()
  local PROJECT
  for PROJECT in "${PROJECT_NAMES[@]}"; do
    local URLS_FILE="${LISTS_DIR}/${PROJECT}.urls"
    local LIST_FILE="${LISTS_DIR}/${PROJECT}.list"
    : > "${LIST_FILE}"
    local N=0
    local URL BASENAME TILE_TIF
    while IFS= read -r URL; do
      [[ -z "${URL}" ]] && continue
      BASENAME="${URL##*/}"; BASENAME="${BASENAME%.tif}"
      TILE_TIF="${DEM_DIR}/${BASENAME}.tif"
      if [[ -f "${TILE_TIF}" ]]; then
        echo "${TILE_TIF}" >> "${LIST_FILE}"
        N=$((N + 1))
      else
        MISSING=$((MISSING + 1))
      fi
    done < "${URLS_FILE}"
    PROJECT_READY["${PROJECT}"]="${N}"
    [[ ${N} -gt 0 ]] && READY_PROJECTS+=("${PROJECT}")
  done
  PROJECT_NAMES=("${READY_PROJECTS[@]}")

  if [[ ${#PROJECT_NAMES[@]} -eq 0 ]]; then
    echo "ERROR: no DEM tiles available to mosaic (${MISSING} missing)"
    exit 1
  fi

  echo "  Projects ready: ${#PROJECT_NAMES[@]}  (${MISSING} missing tiles)"
  for PROJECT in "${PROJECT_NAMES[@]}"; do
    printf "    %-60s %5d tiles\n" "${PROJECT}" "${PROJECT_READY[${PROJECT}]}"
  done

  # ── Output dirs for this run ─────────────────────────────────────────────────
  local _run_root="${PROJECTS_DIR}/${_project}/${_hex}"
  local OUT_DIR="${_run_root}/kml"
  local COG_DIR="${_run_root}/cog"
  local KMZ_DIR="${_run_root}/kmz"

  # KML_STAGE_ROOT: where the tile pyramid is built. When kml is a requested
  # output, build into OUT_DIR (deliverable). When only kmz was requested,
  # the un-zipped tree is intermediate — build under _proj_work so the EXIT
  # trap reclaims it after KMZ packaging.
  local KML_STAGE_ROOT
  if [[ ${OUTPUT_KML} -eq 1 ]]; then
    KML_STAGE_ROOT="${OUT_DIR}"
  else
    KML_STAGE_ROOT="${_proj_work}/kml_stage"
  fi

  # ── Step 6: shading derivation + KML tile pyramids ──────────────────────────
  echo "=========================================="
  if [[ ${NEED_PYRAMID} -eq 1 ]]; then
    echo "STEP 6: Deriving shadings + generating KML tile pyramids (${#SHADINGS[@]} shading(s) × ${#PROJECT_NAMES[@]} project(s))"
  else
    echo "STEP 6: Deriving shadings (${#SHADINGS[@]} shading(s) × ${#PROJECT_NAMES[@]} project(s)) — KML pyramid skipped"
  fi
  echo "=========================================="

  [[ ${NEED_PYRAMID} -eq 1 ]] && mkdir -p "${KML_STAGE_ROOT}"

  declare -A DEM_VRT=()
  for PROJECT in "${PROJECT_NAMES[@]}"; do
    local VRT="${_proj_work}/${PROJECT}_dem.vrt"
    build_dem_vrt "${LISTS_DIR}/${PROJECT}.list" "${VRT}"
    DEM_VRT["${PROJECT}"]="${VRT}"
  done

  local SHADING
  for SHADING in "${SHADINGS[@]}"; do
    local SHADING_DIR="${KML_STAGE_ROOT}/${SHADING}"
    [[ ${NEED_PYRAMID} -eq 1 ]] && mkdir -p "${SHADING_DIR}"

    for PROJECT in "${PROJECT_NAMES[@]}"; do
      local SHADE_TIF="${_proj_work}/${SHADING}_${PROJECT}.tif"

      echo "------------------------------------------"
      echo "${SHADING} / ${PROJECT}  (${PROJECT_COUNT[${PROJECT}]} tiles)"
      echo "------------------------------------------"

      echo "  Deriving ${SHADING}..."
      derive_shading "${SHADING}" "${DEM_VRT[${PROJECT}]}" "${SHADE_TIF}"

      if [[ ${NEED_PYRAMID} -eq 1 ]]; then
        local PROJ_OUT="${SHADING_DIR}/${PROJECT}"
        local WGS84_TIF; WGS84_TIF=$(mktemp -p "${_proj_work}" wgs84_XXXXXX.tif)
        mkdir -p "${PROJ_OUT}"

        echo "  Reprojecting to WGS84..."
        reproject_to_wgs84 "${SHADE_TIF}" "${WGS84_TIF}"

        echo "  Building tile pyramid..."
        # min-zoom=0: gdal's auto-pick is "data fits in ~1 tile" which lands
        # at zoom 7-8 for county-sized data. Tiles that small (≤1° on a side)
        # fall under Google Earth's default 128-px LOD threshold at typical
        # viewing altitudes, so the overlay stays invisible until you zoom
        # deep in. Forcing min-zoom=0 produces overview tiles that span tens
        # of degrees — easily clearing the LOD threshold at any altitude.
        # --skip-blank drops the mostly-empty overview tiles for small data
        # (PNG transparency compresses to ~nothing anyway), so storage cost
        # is a handful of extra tiles per super-overlay.
        #
        # max-zoom explicit: gdal's auto-pick rounds down by one for sub-
        # meter data (OSGeo/gdal#2799, #3460), so we still compute it.
        # cubic resampling preserves alpha-edge fidelity; average bled
        # nodata into neighbors across overview levels and produced halos.
        local MAX_ZOOM LK_LON LK_LAT LK_RANGE
        { read -r MAX_ZOOM; read -r LK_LON LK_LAT LK_RANGE; } \
          < <(compute_zoom_and_lookat "${WGS84_TIF}") || true
        echo "  Zoom range: 0-${MAX_ZOOM} (min=world, max=native resolution)"
        run_gdal "${GDAL[@]}" raster tile \
          --tiling-scheme WorldCRS84Quad \
          --kml \
          --webviewer none \
          --min-zoom 0 \
          --max-zoom "${MAX_ZOOM}" \
          -r cubic \
          --overview-resampling cubic \
          --skip-blank \
          --title "${PROJECT}" \
          -j ALL_CPUS \
          "${WGS84_TIF}" "${PROJ_OUT}"

        # Inject <LookAt> so Google Earth focuses on the actual data instead
        # of the union of world-spanning overview tile bounds.
        if [[ -f "${PROJ_OUT}/doc.kml" ]]; then
          if [[ -n "${LK_LON:-}" ]]; then
            inject_lookat "${PROJ_OUT}/doc.kml" "${LK_LON}" "${LK_LAT}" "${LK_RANGE}"
            echo "  LookAt: ${LK_LON}, ${LK_LAT} @ ${LK_RANGE}m"
          fi
          ensure_root_networklink "${PROJ_OUT}/doc.kml" "${PROJ_OUT}"
        fi

        rm -f "${WGS84_TIF}"
      fi

      # SHADE_TIF (native CRS) is the COG source for Step 7. Keep it in
      # _proj_work when cog output is requested; EXIT trap cleans _proj_work.
      [[ ${OUTPUT_COG} -eq 1 ]] || rm -f "${SHADE_TIF}"
    done
  done

  # ── Step 7: optional COG output ─────────────────────────────────────────────
  # Produces self-contained Cloud-Optimized GeoTIFFs. CRS resolved per project.
  local COG_PATHS=()
  if [[ ${OUTPUT_COG} -eq 1 ]]; then
    echo "=========================================="
    echo "STEP 7: Packaging COG (DEM + shadings)"
    echo "=========================================="
    mkdir -p "${COG_DIR}"
    declare -A PROJECT_COG_CRS=()
    local COG_CRS_SUMMARY=""

    local TARGET_CRS DEM_OUT
    for PROJECT in "${PROJECT_NAMES[@]}"; do
      TARGET_CRS=$(cog_resolve_crs "${DEM_VRT[${PROJECT}]}")
      PROJECT_COG_CRS["${PROJECT}"]="${TARGET_CRS}"
      DEM_OUT="${COG_DIR}/${PROJECT}_dem.tif"
      echo "  ${PROJECT}/dem → ${TARGET_CRS}"
      build_cog_dem "${DEM_VRT[${PROJECT}]}" "${DEM_OUT}" "${TARGET_CRS}"
      COG_PATHS+=("${DEM_OUT}")
      COG_CRS_SUMMARY+="${PROJECT}=${TARGET_CRS} "
    done

    local SHADE_TIF SHADE_OUT
    for SHADING in "${SHADINGS[@]}"; do
      for PROJECT in "${PROJECT_NAMES[@]}"; do
        SHADE_TIF="${_proj_work}/${SHADING}_${PROJECT}.tif"
        SHADE_OUT="${COG_DIR}/${SHADING}__${PROJECT}.tif"
        TARGET_CRS="${PROJECT_COG_CRS[${PROJECT}]}"
        echo "  ${SHADING}/${PROJECT} → ${TARGET_CRS}"
        build_cog_shade "${SHADE_TIF}" "${SHADE_OUT}" "${TARGET_CRS}"
        COG_PATHS+=("${SHADE_OUT}")
      done
    done

    write_cog_readme "${COG_DIR}" "${COG_CRS_SUMMARY% }"
  fi

  # ── Step 8: optional KMZ packaging (one .kmz per super-overlay) ─────────────
  # A KMZ archive expects exactly one doc.kml at its root. Each (shading,
  # project) super-overlay is independently complete, so we ship one KMZ
  # per super-overlay rather than zipping the whole tree.
  local KMZ_PATHS=()
  if [[ ${OUTPUT_KMZ} -eq 1 ]]; then
    echo "=========================================="
    echo "STEP 8: Packaging KMZ (one per super-overlay)"
    echo "=========================================="
    mkdir -p "${KMZ_DIR}"
    local SRC KMZ_OUT
    for SHADING in "${SHADINGS[@]}"; do
      for PROJECT in "${PROJECT_NAMES[@]}"; do
        SRC="${KML_STAGE_ROOT}/${SHADING}/${PROJECT}"
        KMZ_OUT="${KMZ_DIR}/${SHADING}__${PROJECT}.kmz"
        package_kmz "${SRC}" "${KMZ_OUT}"
        echo "  ${SHADING}/${PROJECT}: ${KMZ_OUT} ($(human_bytes "$(stat -c %s "${KMZ_OUT}")"))"
        KMZ_PATHS+=("${KMZ_OUT}")
      done
    done
  fi

  echo "=========================================="
  echo "ALL DONE  [${_hex}]  ${_project}"
  echo "=========================================="
  [[ ${OUTPUT_KML} -eq 1 ]] && echo "KML : ${OUT_DIR}/"
  [[ ${#KMZ_PATHS[@]} -gt 0 ]] && echo "KMZ : ${KMZ_DIR}/"
  [[ ${#COG_PATHS[@]} -gt 0 ]] && echo "COG : ${COG_DIR}/"
  echo "=========================================="
}

# ─── Generate hex IDs and dispatch ───────────────────────────────────────────
mkdir -p "${LIDAR_DIR}/logs"

declare -a _HEXES=()
for (( _i=0; _i<_N_PROJECTS; _i++ )); do
  _hex=$(gen_hex_id)
  _HEXES+=("${_hex}")
done

echo "Dispatching ${_N_PROJECTS} run(s) (jobs=${JOBS})..."
echo "  System: $(diag_system_snapshot "${GIS_DIR}")"
for (( _i=0; _i<_N_PROJECTS; _i++ )); do
  printf "  [%d/%d] %s  →  %s\n" \
    "$((_i+1))" "${_N_PROJECTS}" \
    "${_FANOUT_PROJECTS[_i]}" "${_HEXES[_i]}"
done

# Supervisor subshell: manages concurrency, cleans up parent WORK_DIR when done.
# Inherits all functions and variables via subshell fork.
(
  _active=0
  for (( _i=0; _i<_N_PROJECTS; _i++ )); do
    _run_one_project \
      "${_FANOUT_PROJECTS[_i]}" \
      "${_HEXES[_i]}" \
      "${_FANOUT_URLFILES[_i]}" &
    _active=$(( _active + 1 ))
    if (( _active >= JOBS )); then
      wait -n 2>/dev/null || true
      _active=$(( _active - 1 ))
    fi
  done
  wait
  rm -rf "${WORK_DIR}"
) &
disown

echo "  Log(s) : ${LIDAR_DIR}/logs/"
echo "  Track  : lidar list"
